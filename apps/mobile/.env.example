# Скопируйте в .env и заполните. Supabase → Project Settings → API Keys.
# EXPO_PUBLIC_ попадает в сборку приложения — поэтому здесь только publishable key.
EXPO_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...).
EXPO_PUBLIC_SUPABASE_KEY=

# Адрес сайта с API ИИ-помощника (apps/web на Vercel), без / в конце.
EXPO_PUBLIC_API_URL=https://ai-navigator-omega-dusky.vercel.app

# Публичный iOS-ключ RevenueCat (appl_…): RevenueCat → проект → Apps & providers → iOS-приложение →
# Public API Key. Его можно класть в приложение. Пусто — покупок нет, приложение работает без подписки.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
