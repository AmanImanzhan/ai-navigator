# Скопируйте в .env.local и заполните. На Netlify — Project configuration → Environment variables.

# Supabase (Project Settings → API Keys). Только на сервере: в браузер не попадают.
SUPABASE_URL=
# Publishable key (sb_publishable_...) — проверка токенов в API и вход в админку через Google.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — обходит все правила доступа. Только сервер, на Netlify — «Contains secret values».
# Нужен админке (/admin) и webhook RevenueCat (запись подписок). ИИ-помощнику он не нужен.
SUPABASE_SECRET_KEY=

# Ключ Anthropic для ИИ-помощника (sk-ant-...). Только сервер, на Netlify — «Contains secret values».
ANTHROPIC_API_KEY=

# Секрет webhook RevenueCat (/api/revenuecat/webhook). Длинная случайная строка: openssl rand -hex 32.
# В RevenueCat → Integrations → Webhooks → Authorization header: Bearer <этот секрет>.
# Только сервер, на Netlify — «Contains secret values».
REVENUECAT_WEBHOOK_SECRET=

# Sentry — отчёты об ошибках сайта, API и админки. DSN: Sentry → проект (Next.js) → Settings →
# Client Keys (DSN). Один и тот же DSN в обе переменные. Пусто — Sentry выключен.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Необязательно: понятные строки кода в отчётах (source maps). Без них сборка проходит как обычно.
# SENTRY_AUTH_TOKEN — секрет (на Netlify — «Contains secret values»), в .env.local не нужен.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Организация в EU — адрес Sentry рядом с токеном (на Netlify обязателен, если есть токен).
SENTRY_URL=https://de.sentry.io/

# Адрес сайта для SEO (canonical, sitemap). На Netlify можно не задавать — возьмётся адрес сайта (URL).
NEXT_PUBLIC_SITE_URL=
