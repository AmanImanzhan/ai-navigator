# Скопируйте в .env.local и заполните. На Vercel — Project → Settings → Environment Variables.

# Supabase (Project Settings → API Keys). Только на сервере: в браузер не попадают.
SUPABASE_URL=
# Publishable key (sb_publishable_...) — для проверки токенов вошедших пользователей в API.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — обходит все правила доступа. Только сервер, на Vercel — Sensitive.
# Пока не используется: понадобится админ-панели. ИИ-помощнику он не нужен.
SUPABASE_SECRET_KEY=

# Ключ Anthropic для ИИ-помощника (sk-ant-...). Только сервер, на Vercel — Sensitive.
ANTHROPIC_API_KEY=

# Адрес сайта для SEO (canonical, sitemap). На Vercel можно не задавать — возьмётся адрес проекта.
NEXT_PUBLIC_SITE_URL=
