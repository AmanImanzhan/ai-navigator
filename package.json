{
  "name": "ai-navigator",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:push": "supabase db push --remote",
    "db:types": "supabase gen types typescript --remote --schema public > packages/shared/src/database.types.ts",
    "seed:content": "tsx --tsconfig scripts/tsconfig.json scripts/seed-content.ts",
    "ai:smoke": "tsx --tsconfig scripts/tsconfig.json scripts/ai-smoke.ts",
    "brand:assets": "tsx --tsconfig scripts/tsconfig.json scripts/generate-brand-assets.mts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@types/node": "^22.20.5",
    "sharp": "^0.35.5",
    "supabase": "^3.1.0",
    "tsx": "^4.23.15"
  }
}
