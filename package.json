{
  "name": "ai-navigator",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:push": "supabase db push --remote",
    "db:types": "supabase gen types typescript --remote --schema public > packages/shared/src/database.types.ts",
    "seed:content": "tsx --tsconfig scripts/tsconfig.json scripts/seed-content.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@types/node": "^22.20.5",
    "supabase": "^3.1.0",
    "tsx": "^4.23.15"
  }
}
